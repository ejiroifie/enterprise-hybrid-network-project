enable
configure terminal

hostname BR-R1

! Configure Subinterfaces for Branch VLANs (Router-on-a-Stick)
interface GigabitEthernet0/0
 description TRUNK_TO_BR-SW1
 no shutdown
exit

interface GigabitEthernet0/0.30
 description BRANCH_SALES_VLAN_30
 encapsulation dot1Q 30
 ip address 10.10.30.1 255.255.255.0
 no shutdown
exit

interface GigabitEthernet0/0.40
 description BRANCH_IT_VLAN_40
 encapsulation dot1Q 40
 ip address 10.10.40.1 255.255.255.0
 no shutdown
exit

! Configure Point-to-Point WAN Link to HQ-R1
interface GigabitEthernet0/1
 description P2P_LINK_TO_HQ-R1
 ip address 10.0.1.2 255.255.255.252
 no shutdown
exit

! Configure Static Default Route to HQ
ip route 0.0.0.0 0.0.0.0 10.0.1.1

end
copy running-config startup-config
